# WeekendGate — payment (activate when merchant account is ready)
# PAYMENT_ENV=sandbox
# PAYMENT_PROVIDER=sandbox-hosted
# PAYMENT_MERCHANT_ID=
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_WEBHOOK_ALLOW_SANDBOX_HEADER=0
# ALLOW_DEMO_CHECKOUT_PAY=0
# PAYMENT_KNET_ENABLED=false
# PAYMENT_APPLE_PAY_ENABLED=false

# Customer unlock OTP (set to 1 after WhatsApp/SMS delivery is ready)
# SHOP_UNLOCK_REQUIRE_OTP=0
# SHOP_OTP_PEPPER=
# SHOP_OTP_ALLOW_LOG=0

# Trip builder mock search (off in production builds by default)
# NEXT_PUBLIC_WG_TRIP_USE_MOCK=0

# Site
# NEXT_PUBLIC_SITE_ENV=production
# NEXT_PUBLIC_API_URL=https://api.weekendgate.com

# Platform v2 (Trip Builder, Deals, Destinations, Loyalty, …)
# Keep OFF on production until ready. Does not change existing homepage when unset.
# NEXT_PUBLIC_WG_PLATFORM=0
# WG_PLATFORM=0

# Glass/mobile-first UI reskin (off by default — set to 1 to enable)
# NEXT_PUBLIC_WG_NEW_UI=0

# Hotelbeds — already configured on the server (do not commit secrets)
# HOTELBEDS_API_KEY=
# HOTELBEDS_API_SECRET=
# HOTELBEDS_BASE_URL=https://api.test.hotelbeds.com

# Hotelbeds Transfers — separate suite keys (do not reuse hotel keys)
# TRANSFER_PROVIDER=hotelbeds-transfers
# HOTELBEDS_TRANSFER_API_KEY=
# HOTELBEDS_TRANSFER_API_SECRET=
# HOTELBEDS_TRANSFER_BASE_URL=https://api.test.hotelbeds.com

# Hotelbeds Activities — separate suite keys (do not reuse hotel/transfer keys)
# ACTIVITY_PROVIDER=hotelbeds-activities
# HOTELBEDS_ACTIVITY_API_KEY=
# HOTELBEDS_ACTIVITY_API_SECRET=
# HOTELBEDS_ACTIVITY_BASE_URL=https://api.test.hotelbeds.com

# Flights — deferred until provider contract
# FLIGHT_PROVIDER=mock

# OpenAI / Voice (server only — never expose to the browser)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_STT_MODEL=whisper-1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# AI_PROVIDER=openai
