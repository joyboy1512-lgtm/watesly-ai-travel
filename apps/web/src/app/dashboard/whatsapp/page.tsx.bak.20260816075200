"use client";

import Link from "next/link";
import { useEffect, useState } from "react";
import { AppShell } from "@/components/AppShell";
import { apiFetch } from "@/lib/api";

type WaAccount = {
  id: string;
  phoneNumberId: string;
  businessAccountId?: string | null;
  displayPhone?: string | null;
  status: string;
  channelName?: string | null;
  channelType?: string | null;
  isDefault?: boolean;
  hasAccessToken?: boolean;
  webhookVerifiedAt?: string | null;
};

const API_URL = process.env.NEXT_PUBLIC_API_URL || "http://localhost:3001";

const STATUS_LABEL: Record<string, string> = {
  connected: "متصل",
  pending: "قيد الإعداد",
  disconnected: "غير متصل",
};

const CHANNEL_TYPE_LABEL: Record<string, string> = {
  whatsapp: "واتساب",
};

const emptyForm = {
  channelName: "",
  phoneNumberId: "",
  businessAccountId: "",
  displayPhone: "",
  accessToken: "mock",
  status: "connected",
  channelType: "whatsapp",
  isDefault: false,
};

export default function WhatsAppPage() {
  const [accounts, setAccounts] = useState<WaAccount[]>([]);
  const [form, setForm] = useState(emptyForm);
  const [editingId, setEditingId] = useState<string | null>(null);
  const [error, setError] = useState("");
  const [ok, setOk] = useState("");
  const [loading, setLoading] = useState(false);
  const [busyId, setBusyId] = useState<string | null>(null);

  async function load() {
    const rows = await apiFetch<WaAccount[]>("/whatsapp/accounts");
    setAccounts(rows);
  }

  useEffect(() => {
    load().catch((err: Error) => setError(err.message));
  }, []);

  function resetForm() {
    setForm(emptyForm);
    setEditingId(null);
  }

  async function saveChannel() {
    setError("");
    setOk("");
    if (!form.phoneNumberId.trim()) {
      setError("Phone Number ID مطلوب");
      return;
    }
    setLoading(true);
    try {
      await apiFetch("/whatsapp/accounts", {
        method: "POST",
        body: JSON.stringify({
          phoneNumberId: form.phoneNumberId.trim(),
          channelName: form.channelName.trim() || undefined,
          channelType: form.channelType || "whatsapp",
          businessAccountId: form.businessAccountId.trim() || undefined,
          displayPhone: form.displayPhone.trim() || undefined,
          accessToken: form.accessToken.trim() || undefined,
          status: form.status,
          isDefault: form.isDefault,
        }),
      });
      setOk(
        editingId
          ? "تم تحديث القناة بنجاح"
          : "تم إنشاء قناة واتساب جديدة بنجاح",
      );
      resetForm();
      await load();
    } catch (err) {
      setError(err instanceof Error ? err.message : "فشل حفظ القناة");
    } finally {
      setLoading(false);
    }
  }

  function fillFromAccount(account: WaAccount) {
    setEditingId(account.id);
    setForm({
      channelName: account.channelName || "",
      phoneNumberId: account.phoneNumberId,
      businessAccountId: account.businessAccountId || "",
      displayPhone: account.displayPhone || "",
      accessToken: "",
      status: account.status || "connected",
      channelType: account.channelType || "whatsapp",
      isDefault: Boolean(account.isDefault),
    });
    setOk(
      "عدّل الحقول ثم احفظ لتحديث القناة. اترك التوكن فارغًا إن لم ترد تغييره.",
    );
    setError("");
  }

  async function testAccount(id: string) {
    setBusyId(id);
    setError("");
    setOk("");
    try {
      const result = await apiFetch<{
        ok: boolean;
        mode: string;
        message: string;
      }>(`/whatsapp/accounts/${id}/test`, { method: "POST" });
      if (result.ok) setOk(`${result.message} (${result.mode})`);
      else setError(result.message);
      await load();
    } catch (err) {
      setError(err instanceof Error ? err.message : "فشل اختبار الاتصال");
    } finally {
      setBusyId(null);
    }
  }

  async function setDefault(id: string) {
    setBusyId(id);
    setError("");
    setOk("");
    try {
      await apiFetch(`/whatsapp/accounts/${id}/set-default`, {
        method: "POST",
      });
      setOk("تم تعيين القناة كافتراضية للحملات والردود");
      await load();
    } catch (err) {
      setError(err instanceof Error ? err.message : "فشل تعيين القناة الافتراضية");
    } finally {
      setBusyId(null);
    }
  }

  async function removeChannel(id: string) {
    const account = accounts.find((a) => a.id === id);
    const isLast = accounts.length <= 1;
    const isDefault = Boolean(account?.isDefault);

    let message = "هل تريد حذف هذه القناة؟ لا يمكن التراجع.";
    if (isLast && isDefault) {
      message =
        "هذه آخر قناة واتساب وهي الافتراضية. حذفها سيوقف الحملات والردود الآلية. هل تريد المتابعة؟";
    } else if (isLast) {
      message =
        "هذه آخر قناة واتساب. حذفها سيوقف الحملات والردود الآلية. هل تريد المتابعة؟";
    } else if (isDefault) {
      message =
        "هذه القناة الافتراضية. حذفها سيتطلب تعيين قناة أخرى قبل الإرسال. هل تريد المتابعة؟";
    }

    if (!window.confirm(message)) return;
    setBusyId(id);
    setError("");
    setOk("");
    try {
      await apiFetch(`/whatsapp/accounts/${id}`, { method: "DELETE" });
      if (editingId === id) resetForm();
      setOk("تم حذف القناة");
      await load();
    } catch (err) {
      setError(err instanceof Error ? err.message : "فشل حذف القناة");
    } finally {
      setBusyId(null);
    }
  }

  return (
    <AppShell title="قنوات واتساب">
      <div className="panel">
        <p className="hint" style={{ marginTop: 0 }}>
          أنشئ قناة واتساب واحدة أو أكثر لإدارة المحادثات والحملات. القناة
          الافتراضية تُستخدم تلقائيًا في الحملات والردود الآلية. للتطوير
          المحلي استخدم التوكن <code>mock</code>.
        </p>
        <div className="actions" style={{ marginTop: "0.75rem" }}>
          <Link className="btn secondary" href="/dashboard/templates">
            القوالب
          </Link>
          <Link className="btn secondary" href="/dashboard/campaigns">
            الحملات
          </Link>
        </div>
      </div>

      <div className="panel">
        <h3>القنوات ({accounts.length})</h3>
        {accounts.length === 0 ? (
          <div className="wa-empty">
            <div className="wa-empty-icon" aria-hidden>
              📱
            </div>
            <h4>لا توجد قنوات واتساب بعد</h4>
            <p>
              اربط رقم واتساب Business لاستقبال المحادثات وإرسال الحملات.
              أنشئ أول قناة من النموذج أدناه — للتطوير المحلي استخدم التوكن{" "}
              <code>mock</code>.
            </p>
          </div>
        ) : (
          <div className="wa-channel-grid">
            {accounts.map((a) => (
              <div
                key={a.id}
                className={`wa-channel-card${a.isDefault ? " is-default" : ""}`}
              >
                <div className="wa-channel-card-top">
                  <div>
                    <h4>{a.channelName || a.displayPhone || a.phoneNumberId}</h4>
                    <p className="hint">
                      {CHANNEL_TYPE_LABEL[a.channelType || "whatsapp"] ||
                        a.channelType}
                    </p>
                  </div>
                  <div className="wa-channel-badges">
                    {a.isDefault ? (
                      <span className="wi-pill wa">افتراضية</span>
                    ) : null}
                    <span
                      className={`wi-pill status-${a.status === "connected" ? "connected" : a.status === "pending" ? "pending" : "disconnected"}`}
                    >
                      {STATUS_LABEL[a.status] || a.status}
                    </span>
                  </div>
                </div>

                <div className="wa-channel-meta">
                  <span>رقم العرض: {a.displayPhone || "—"}</span>
                  <span>Phone Number ID: {a.phoneNumberId}</span>
                  <span>Business Account: {a.businessAccountId || "—"}</span>
                  <span>التوكن: {a.hasAccessToken ? "محفوظ" : "غير موجود"}</span>
                </div>

                <div className="wa-channel-actions">
                  <button
                    type="button"
                    className="btn secondary"
                    disabled={busyId === a.id}
                    onClick={() => void testAccount(a.id)}
                  >
                    {busyId === a.id ? "جارٍ..." : "اختبار"}
                  </button>
                  <button
                    type="button"
                    className="btn secondary"
                    disabled={a.isDefault || busyId === a.id}
                    onClick={() => void setDefault(a.id)}
                  >
                    تعيين كافتراضية
                  </button>
                  <button
                    type="button"
                    className="btn secondary"
                    onClick={() => fillFromAccount(a)}
                  >
                    تعديل
                  </button>
                  <button
                    type="button"
                    className="btn secondary"
                    disabled={busyId === a.id}
                    onClick={() => void removeChannel(a.id)}
                  >
                    حذف
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <div className="panel">
        <h3>{editingId ? "تعديل القناة" : "إنشاء قناة جديدة"}</h3>
        <div className="form-grid">
          <label className="field">
            <span>اسم القناة</span>
            <input
              value={form.channelName}
              onChange={(e) => setForm({ ...form, channelName: e.target.value })}
              placeholder="مثال: دعم العملاء الرئيسي"
            />
          </label>
          <label className="field">
            <span>Phone Number ID *</span>
            <input
              value={form.phoneNumberId}
              onChange={(e) =>
                setForm({ ...form, phoneNumberId: e.target.value })
              }
              placeholder="من Meta Developer"
              disabled={Boolean(editingId)}
            />
          </label>
          <label className="field">
            <span>WhatsApp Business Account ID</span>
            <input
              value={form.businessAccountId}
              onChange={(e) =>
                setForm({ ...form, businessAccountId: e.target.value })
              }
              placeholder="اختياري"
            />
          </label>
          <label className="field">
            <span>رقم العرض</span>
            <input
              value={form.displayPhone}
              onChange={(e) =>
                setForm({ ...form, displayPhone: e.target.value })
              }
              placeholder="+9655xxxxxxx"
            />
          </label>
          <label className="field">
            <span>Access Token</span>
            <input
              type="password"
              value={form.accessToken}
              onChange={(e) =>
                setForm({ ...form, accessToken: e.target.value })
              }
              placeholder="اتركه فارغًا عند التحديث إن لم يتغير"
            />
          </label>
          <label className="field">
            <span>الحالة</span>
            <select
              value={form.status}
              onChange={(e) => setForm({ ...form, status: e.target.value })}
            >
              <option value="connected">متصل</option>
              <option value="pending">قيد الإعداد</option>
              <option value="disconnected">غير متصل</option>
            </select>
          </label>
          <label
            className="field"
            style={{ flexDirection: "row", alignItems: "center", display: "flex", gap: "0.5rem" }}
          >
            <input
              type="checkbox"
              checked={form.isDefault}
              onChange={(e) =>
                setForm({ ...form, isDefault: e.target.checked })
              }
              style={{
                width: "1.1rem",
                height: "1.1rem",
                minHeight: 0,
                padding: 0,
                border: "1px solid var(--line)",
              }}
            />
            <span>تعيين كقناة افتراضية</span>
          </label>
        </div>
        <div className="actions">
          <button
            type="button"
            className="btn"
            disabled={loading || !form.phoneNumberId.trim()}
            onClick={() => void saveChannel()}
          >
            {loading
              ? "جارٍ الحفظ..."
              : editingId
                ? "حفظ التعديلات"
                : "إنشاء القناة"}
          </button>
          {editingId ? (
            <button type="button" className="btn secondary" onClick={resetForm}>
              إلغاء التعديل
            </button>
          ) : null}
        </div>
        <p className="hint">
          Webhook URL: <code>{API_URL}/whatsapp/webhook</code>
          <br />
          Verify Token: متغير البيئة <code>WHATSAPP_VERIFY_TOKEN</code>
        </p>
        {ok ? <p className="hint">{ok}</p> : null}
        {error ? <p className="error">{error}</p> : null}
      </div>
    </AppShell>
  );
}
