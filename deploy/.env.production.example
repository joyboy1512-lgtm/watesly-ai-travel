# انسخ إلى ملف .env في جذر المشروع على السيرفر وعدّل الأسرار
NODE_ENV=production
APP_NAME=WeekendGate Travel

WEB_URL=https://www.weekendgate.com
API_URL=https://api.weekendgate.com
# منافذ داخلية مختلفة عن المشروع الحالي على نفس السيرفر
API_PORT=3011
WEB_PORT=3012

NEXT_PUBLIC_API_URL=https://api.weekendgate.com
CORS_ORIGINS=https://www.weekendgate.com,https://weekendgate.com

# غيّر كلمات المرور قبل الإنتاج
DATABASE_URL=postgresql://watesly:CHANGE_ME_DB_PASSWORD@127.0.0.1:5433/watesly_travel?schema=public
REDIS_URL=redis://127.0.0.1:6380

JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM_2
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_3

FLIGHT_PROVIDER=mock
HOTEL_PROVIDER=mock
TRAVEL_MOCK_ENABLED=true
TRAVEL_DEFAULT_PROVIDER=mock

DEFAULT_CURRENCY=KWD
AI_PROVIDER=mock
