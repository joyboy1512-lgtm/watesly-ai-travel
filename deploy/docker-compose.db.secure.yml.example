# Secure DB/Redis publish example for WeekendGate.
# Bind to loopback only. Password comes from env/secret — never commit real values.
services:
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: weekendgate
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: weekendgate
    ports:
      - "127.0.0.1:5433:5432"
    volumes:
      - weekendgate_pg:/var/lib/postgresql/data

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: ["redis-server", "--save", "", "--appendonly", "no"]
    ports:
      - "127.0.0.1:6380:6379"
    volumes:
      - weekendgate_redis:/data

volumes:
  weekendgate_pg:
  weekendgate_redis:
