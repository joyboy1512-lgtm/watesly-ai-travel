# WeekendGate production inventory / payments / messaging
# Copy values into apps/api/.env and apps/web/.env.production as appropriate.
# Do NOT commit real secrets.

# --- Flights ---
# mock | duffel | amadeus | travelport | travelfusion
FLIGHT_PROVIDER=mock
# DUFFEL_ACCESS_TOKEN=
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=

# --- Hotels ---
# mock | hotelbeds | duffel
HOTEL_PROVIDER=mock
# HOTELBEDS_API_KEY=
# HOTELBEDS_API_SECRET=
# HOTELBEDS_BASE_URL=https://api.test.hotelbeds.com

# --- Payments ---
# sandbox | production
PAYMENT_ENV=sandbox
# PAYMENT_PROVIDER=sandbox-hosted|upayments|tap|myfatoorah
# PAYMENT_MERCHANT_ID=
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_KNET_ENABLED=true
# PAYMENT_APPLE_PAY_ENABLED=false

# --- Platform ---
WG_PLATFORM=1
NEXT_PUBLIC_WG_PLATFORM=1

# --- Analytics (optional beacon) ---
# NEXT_PUBLIC_ANALYTICS_URL=https://www.weekendgate.com/api/analytics/funnel

# --- WhatsApp notifications (optional) ---
# Uses existing WhatsApp account rows when configured in dashboard.
